{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^dev-workflow:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/swift_skills.py\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^dev-workflow:(implementer|implementation-standards-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/swift_skills.py\" stop"
          }
        ]
      }
    ]
  }
}
